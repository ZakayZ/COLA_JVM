@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(COLA REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/COLA_JVMTargets.cmake")

set_and_check(COLA_JVM_CMAKE_DIR "@PACKAGE_COLA_JVM_CMAKE_INSTALL_DIR@")
set_and_check(COLA_JVM_TEMPLATES_DIR "@PACKAGE_COLA_JVM_TEMPLATE_INSTALL_DIR@")
set_and_check(COLA_JVM_API_JAR "@PACKAGE_COLA_JVM_API_INSTALL_DIR@/cola-jvm-api.jar")

list(APPEND CMAKE_MODULE_PATH "${COLA_JVM_CMAKE_DIR}")
include(JvmCOLARegister)

check_required_components(COLA_JVM)
